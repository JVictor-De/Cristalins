// Schema da assinatura Cristalins — fase cr-0-prisma.
// Fonte: "Modelo de dados e arquitetura" do Anexo (super-prompt-cristalins.md).
// Convenções: models/campos em português camelCase; banco em snake_case via @map/@@map;
// dinheiro em Decimal(10,2); datas de regra em America/Sao_Paulo (calculadas na API).

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Papel {
  CLIENTE
  ADMIN

  @@map("papel")
}

enum TipoProduto {
  PRINCIPAL
  COMPLEMENTO
  B2B
  ADDON

  @@map("tipo_produto")
}

enum ObjetivoKit {
  TREINO
  EQUILIBRIO
  CASA
  ESCRITORIO

  @@map("objetivo_kit")
}

enum DiaSemana {
  DOM
  SEG
  TER
  QUA
  QUI
  SEX
  SAB

  @@map("dia_semana")
}

enum Plano {
  FLEX
  TRIMESTRAL
  EMPRESA

  @@map("plano")
}

enum Frequencia {
  SEMANAL
  QUINZENAL
  MENSAL

  @@map("frequencia")
}

enum Janela {
  MANHA
  TARDE

  @@map("janela")
}

enum FormaPagamento {
  PIX
  CARTAO
  BOLETO

  @@map("forma_pagamento")
}

enum StatusAssinatura {
  AGUARDANDO_PAGAMENTO
  ATIVA
  PAUSADA
  SUSPENSA
  CANCELADA

  @@map("status_assinatura")
}

enum StatusCiclo {
  AGENDADO
  COBRADO
  PAGO
  SEPARADO
  EM_ROTA
  ENTREGUE
  PULADO
  CANCELADO
  FALHOU

  @@map("status_ciclo")
}

enum StatusPagamento {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
  ESTORNADO

  @@map("status_pagamento")
}

enum TipoOcorrencia {
  AVARIA
  FALTA

  @@map("tipo_ocorrencia")
}

enum SolucaoOcorrencia {
  REPOSICAO
  CREDITO

  @@map("solucao_ocorrencia")
}

enum StatusOcorrencia {
  ABERTA
  RESOLVIDA

  @@map("status_ocorrencia")
}

// ---------- Cadastro ----------

model Cliente {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String
  cpfCnpj         String    @unique @map("cpf_cnpj") @db.VarChar(14)
  email           String    @unique
  celular         String?   @db.VarChar(20)
  dataNascimento  DateTime? @map("data_nascimento") @db.Date
  senhaHash       String    @map("senha_hash")
  papel           Papel     @default(CLIENTE)
  asaasCustomerId String?   @unique @map("asaas_customer_id")
  aceiteTermosEm  DateTime? @map("aceite_termos_em") @db.Timestamptz(3)
  marketingOk     Boolean   @default(false) @map("marketing_ok")
  codigoIndicacao String?   @unique @map("codigo_indicacao")
  indicadoPorId   String?   @map("indicado_por_id") @db.Uuid
  pushToken       String?   @map("push_token")
  excluidoEm      DateTime? @map("excluido_em") @db.Timestamptz(3)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  indicadoPor   Cliente?       @relation("Indicacao", fields: [indicadoPorId], references: [id], onDelete: SetNull)
  indicados     Cliente[]      @relation("Indicacao")
  enderecos     Endereco[]
  assinaturas   Assinatura[]
  recomendacoes Recomendacao[]
  cartoes       Cartao[]
  creditos      Credito[]

  @@map("clientes")
}

model Endereco {
  id           String   @id @default(uuid()) @db.Uuid
  clienteId    String   @map("cliente_id") @db.Uuid
  apelido      String?
  cep          String   @db.Char(8)
  logradouro   String
  numero       String
  complemento  String?
  bairro       String
  zonaId       String   @map("zona_id") @db.Uuid
  referencia   String?
  instrucoes   String?
  lat          Decimal? @db.Decimal(9, 6)
  lng          Decimal? @db.Decimal(9, 6)
  principal    Boolean  @default(false)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  zona        Zona         @relation(fields: [zonaId], references: [id])
  assinaturas Assinatura[]
  ciclos      Ciclo[]

  @@index([clienteId])
  @@index([zonaId])
  @@map("enderecos")
}

model Zona {
  id          String      @id @default(uuid()) @db.Uuid
  nome        String      @unique
  bairros     String[]
  taxaEntrega Decimal     @map("taxa_entrega") @db.Decimal(10, 2)
  diasEntrega DiaSemana[] @map("dias_entrega")
  ativa       Boolean     @default(true)

  enderecos Endereco[]

  @@map("zonas")
}

// ---------- Catálogo ----------

model Produto {
  id           String      @id @default(uuid()) @db.Uuid
  codigo       String      @unique
  nome         String
  tipo         TipoProduto
  volumeMl     Int         @map("volume_ml")
  ue           Decimal     @db.Decimal(6, 2)
  embalagemQtd Int         @map("embalagem_qtd")
  precoBase    Decimal     @map("preco_base") @db.Decimal(10, 2)
  precoPiso    Decimal     @map("preco_piso") @db.Decimal(10, 2)
  pesoKg       Decimal     @map("peso_kg") @db.Decimal(6, 2)
  estoque      Int?
  validadeDias Int?        @map("validade_dias")
  ativo        Boolean     @default(true)

  kitItens        KitItem[]
  itensAssinatura ItemAssinatura[]
  itensCiclo      ItemCiclo[]

  @@map("produtos")
}

model Kit {
  id       String      @id @default(uuid()) @db.Uuid
  codigo   String      @unique
  nome     String
  objetivo ObjetivoKit @unique

  itens         KitItem[]
  recomendacoes Recomendacao[]

  @@map("kits")
}

model KitItem {
  kitId      String @map("kit_id") @db.Uuid
  produtoId  String @map("produto_id") @db.Uuid
  quantidade Int

  kit     Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([kitId, produtoId])
  @@map("kit_itens")
}

model Recomendacao {
  id            String     @id @default(uuid()) @db.Uuid
  clienteId     String     @map("cliente_id") @db.Uuid
  respostas     Json
  kitId         String?    @map("kit_id") @db.Uuid
  multiplicador Int?
  frequencia    Frequencia?
  itens         Json
  ue            Decimal    @db.Decimal(8, 2)
  valorEstimado Decimal?   @map("valor_estimado") @db.Decimal(10, 2)
  perfilEmpresa Boolean    @default(false) @map("perfil_empresa")
  criadoEm      DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  kit     Kit?    @relation(fields: [kitId], references: [id])

  @@index([clienteId])
  @@map("recomendacoes")
}

// ---------- Assinatura e ciclos ----------

model Assinatura {
  id             String           @id @default(uuid()) @db.Uuid
  clienteId      String           @map("cliente_id") @db.Uuid
  enderecoId     String           @map("endereco_id") @db.Uuid
  plano          Plano
  frequencia     Frequencia
  janela         Janela
  formaPagamento FormaPagamento   @default(PIX) @map("forma_pagamento")
  cartaoId       String?          @map("cartao_id") @db.Uuid
  cupomId        String?          @map("cupom_id") @db.Uuid
  status         StatusAssinatura @default(AGUARDANDO_PAGAMENTO)
  inicio         DateTime?        @db.Date
  fimCompromisso DateTime?        @map("fim_compromisso") @db.Date
  criadoEm       DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cliente  Cliente          @relation(fields: [clienteId], references: [id])
  endereco Endereco         @relation(fields: [enderecoId], references: [id])
  cartao   Cartao?          @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  cupom    Cupom?           @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  itens    ItemAssinatura[]
  ciclos   Ciclo[]

  @@index([clienteId])
  @@index([status])
  @@map("assinaturas")
}

model ItemAssinatura {
  assinaturaId String @map("assinatura_id") @db.Uuid
  produtoId    String @map("produto_id") @db.Uuid
  quantidade   Int

  assinatura Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  produto    Produto    @relation(fields: [produtoId], references: [id])

  @@id([assinaturaId, produtoId])
  @@map("itens_assinatura")
}

model Ciclo {
  id                String      @id @default(uuid()) @db.Uuid
  assinaturaId      String      @map("assinatura_id") @db.Uuid
  numero            Int
  enderecoId        String      @map("endereco_id") @db.Uuid
  janela            Janela
  dataEntrega       DateTime    @map("data_entrega") @db.Date
  dataCorte         DateTime    @map("data_corte") @db.Timestamptz(3)
  tentativasEntrega Int         @default(0) @map("tentativas_entrega")
  status            StatusCiclo @default(AGENDADO)
  criadoEm          DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm      DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  assinatura   Assinatura    @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  endereco     Endereco      @relation(fields: [enderecoId], references: [id])
  calculoPreco CalculoPreco?
  itens        ItemCiclo[]
  pagamentos   Pagamento[]
  ocorrencias  Ocorrencia[]

  @@unique([assinaturaId, numero])
  @@index([status, dataEntrega])
  @@map("ciclos")
}

model ItemCiclo {
  cicloId       String  @map("ciclo_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  ciclo   Ciclo   @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([cicloId, produtoId])
  @@map("itens_ciclo")
}

model CalculoPreco {
  id         String   @id @default(uuid()) @db.Uuid
  cicloId    String   @unique @map("ciclo_id") @db.Uuid
  subtotal   Decimal  @db.Decimal(10, 2)
  fatores    Json
  frete      Decimal  @db.Decimal(10, 2)
  creditos   Decimal  @default(0) @db.Decimal(10, 2)
  valorFinal Decimal  @map("valor_final") @db.Decimal(10, 2)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  ciclo Ciclo @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  @@map("calculos_preco")
}

// ---------- Pagamento ----------

model Pagamento {
  id             String          @id @default(uuid()) @db.Uuid
  cicloId        String          @map("ciclo_id") @db.Uuid
  asaasPaymentId String?         @unique @map("asaas_payment_id")
  forma          FormaPagamento
  valor          Decimal         @db.Decimal(10, 2)
  vencimento     DateTime        @db.Date
  linkPagamento  String?         @map("link_pagamento")
  status         StatusPagamento @default(PENDENTE)
  pagoEm         DateTime?       @map("pago_em") @db.Timestamptz(3)
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  ciclo Ciclo @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  @@index([cicloId])
  @@map("pagamentos")
}

// Só token do Asaas e 4 últimos dígitos; nunca número nem CVV (pós-AP2).
model Cartao {
  id         String   @id @default(uuid()) @db.Uuid
  clienteId  String   @map("cliente_id") @db.Uuid
  asaasToken String   @map("asaas_token")
  bandeira   String
  final      String   @db.Char(4)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  assinaturas Assinatura[]

  @@index([clienteId])
  @@map("cartoes")
}

model Credito {
  id        String    @id @default(uuid()) @db.Uuid
  clienteId String    @map("cliente_id") @db.Uuid
  valor     Decimal   @db.Decimal(10, 2)
  motivo    String
  expiraEm  DateTime? @map("expira_em") @db.Timestamptz(3)
  usadoEm   DateTime? @map("usado_em") @db.Timestamptz(3)
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("creditos")
}

model Cupom {
  id         String    @id @default(uuid()) @db.Uuid
  codigo     String    @unique
  percentual Decimal   @db.Decimal(5, 2)
  validade   DateTime? @db.Date
  usosMax    Int?      @map("usos_max")
  usos       Int       @default(0)

  assinaturas Assinatura[]

  @@map("cupons")
}

// ---------- Operação ----------

model Ocorrencia {
  id         String             @id @default(uuid()) @db.Uuid
  cicloId    String             @map("ciclo_id") @db.Uuid
  tipo       TipoOcorrencia
  fotoUrl    String?            @map("foto_url")
  // cr-6: item avariado ou faltante (crédito e reposição do RN15 precisam de produto e quantidade)
  produtoId  String?            @map("produto_id") @db.Uuid
  quantidade Int?
  solucao    SolucaoOcorrencia?
  status     StatusOcorrencia   @default(ABERTA)
  criadoEm   DateTime           @default(now()) @map("criado_em") @db.Timestamptz(3)

  ciclo Ciclo @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  @@index([cicloId])
  @@map("ocorrencias")
}

// Fatores de preço versionados por vigência (ex.: DEMANDA_VERAO = 0.05 de 01/12 a 31/03).
// valor é fração (0.05 = 5%).
model FatorPreco {
  id       String    @id @default(uuid()) @db.Uuid
  chave    String
  valor    Decimal   @db.Decimal(6, 4)
  ativoDe  DateTime  @map("ativo_de") @db.Date
  ativoAte DateTime? @map("ativo_ate") @db.Date

  @@unique([chave, ativoDe])
  @@map("fatores_preco")
}

model EventoWebhook {
  id           String    @id @default(uuid()) @db.Uuid
  idEvento     String    @unique @map("id_evento")
  tipo         String
  payload      Json
  recebidoEm   DateTime  @default(now()) @map("recebido_em") @db.Timestamptz(3)
  processadoEm DateTime? @map("processado_em") @db.Timestamptz(3)
  erro         String?

  @@index([processadoEm])
  @@map("eventos_webhook")
}

model ListaEspera {
  id       String   @id @default(uuid()) @db.Uuid
  email    String
  cep      String   @db.Char(8)
  bairro   String?
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@map("lista_espera")
}
