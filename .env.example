# Copie para .env e preencha. Não commite .env.

DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Homologação / Coolify hml (sandbox). Produção: https://api.asaas.com/v3 + chave $aact_prod_*
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_MODE=sandbox
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
FCM_CREDENTIALS=
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
SENTRY_DSN=
# Origens do Flutter Web (vírgula). Ex. hml: https://cristalins.peladeiro.cloud
CORS_ORIGINS=
TZ=America/Sao_Paulo

# Compose local (não são segredos de produção; ajuste no .env)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
